# Copy to .env and fill in.  .env is gitignored.

# Where all meeting data (DB, audio, notes) is stored.
MEETINGSCRIBE_DATA_DIR=C:\cornell\meetingnotes

# HuggingFace token — ONLY needed to download the gated pyannote diarization
# weights. Inference still runs locally/offline once downloaded.
# Create one at https://huggingface.co/settings/tokens (read scope is enough).
HUGGINGFACE_TOKEN=

# --- Live transcription (local CPU) ---
MEETINGSCRIBE_LIVE_MODEL=base.en
MEETINGSCRIBE_LIVE_COMPUTE=int8

# --- Batch transcription (Cornell GPU, or local fallback) ---
MEETINGSCRIBE_BATCH_MODEL=large-v3

# --- Diarization (who said what among the remote participants) ---
# resemblyzer = key-free, bundled weights, no token (DEFAULT)
# pyannote    = higher quality, needs HUGGINGFACE_TOKEN + accepting the model's
#               free gated terms at https://hf.co/pyannote/speaker-diarization-3.1
MEETINGSCRIBE_DIARIZER=resemblyzer
MEETINGSCRIBE_DIAR_THRESHOLD=0.55

# --- Notes LLM backend: llamacpp | transformers | extractive ---
MEETINGSCRIBE_LLM_BACKEND=llamacpp
# Path to a quantized GGUF model (downloaded by scripts/download_models.py).
MEETINGSCRIBE_GGUF_PATH=

# --- Zoom integration (OPTIONAL: auto-record scheduled meetings) ---
# Server-to-Server OAuth (simplest, no browser redirect): set all three.
# User-managed OAuth: set CLIENT_ID + CLIENT_SECRET + REDIRECT_URI, then visit
#   http://localhost:8765/oauth/zoom/start to authorize.
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_ACCOUNT_ID=
ZOOM_REDIRECT_URI=http://localhost:8765/oauth/zoom/callback
# Auto-start capture when a scheduled meeting begins (and auto-stop after).
MEETINGSCRIBE_AUTOSTART=1
MEETINGSCRIBE_AUTOSTART_LEAD_SEC=120
MEETINGSCRIBE_AUTOSTART_BUFFER_SEC=600

# --- Cornell remote compute (heavy batch pipeline) ---
# Leave MEETINGSCRIBE_REMOTE=0 to run batch locally on CPU.
MEETINGSCRIBE_REMOTE=1
CORNELL_USER=me484
CORNELL_LOGIN_HOST=unicorn-login-04.coecis.cornell.edu
CORNELL_REMOTE_DIR=/home/me484/meetingnotes
